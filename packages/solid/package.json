{
	"name": "@klass/solid",
	"version": "4.0.0-next.30",
	"description": "Class variant utility for Solid",
	"keywords": [
		"class",
		"classname",
		"variant",
		"variants",
		"utility",
		"responsive",
		"typescript",
		"solid",
		"component",
		"styled",
		"polymorphic"
	],
	"license": "MIT",
	"author": {
		"name": "flamrdevs"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./create": {
			"types": "./dist/create.d.ts",
			"default": "./dist/create.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./mono": {
			"types": "./dist/mono/index.d.ts",
			"default": "./dist/mono/index.js"
		},
		"./mono/create": {
			"types": "./dist/mono/create.d.ts",
			"default": "./dist/mono/create.js"
		}
	},
	"typesVersions": {
		">=3.1": {
			"*": [
				"./dist/*.d.ts",
				"./dist/index.d.ts"
			],
			"mono": [
				"./dist/mono/*.d.ts",
				"./dist/mono/index.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"homepage": "https://klass.pages.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flamrdevs/klass.git",
		"directory": "packages/solid"
	},
	"scripts": {
		"build": "vite build"
	},
	"peerDependencies": {
		"@klass/core": "workspace:*",
		"solid-js": "^1"
	},
	"devDependencies": {
		"@klass/core": "workspace:*",
		"solid-js": "^1"
	},
	"publishConfig": {
		"access": "public"
	}
}
