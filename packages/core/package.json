{
	"name": "@klass/core",
	"version": "4.0.0-next.30",
	"description": "Class variant utility",
	"keywords": [
		"class",
		"classname",
		"variant",
		"variants",
		"utility",
		"responsive",
		"typescript",
		"framework-agnostic",
		"preact",
		"qwik",
		"react",
		"solid",
		"vue"
	],
	"license": "MIT",
	"author": {
		"name": "flamrdevs"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./create": {
			"types": "./dist/create.d.ts",
			"default": "./dist/create.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./group": {
			"types": "./dist/group/index.d.ts",
			"default": "./dist/group/index.js"
		},
		"./group/create": {
			"types": "./dist/group/create.d.ts",
			"default": "./dist/group/create.js"
		},
		"./slots": {
			"types": "./dist/slots/index.d.ts",
			"default": "./dist/slots/index.js"
		},
		"./slots/create": {
			"types": "./dist/slots/create.d.ts",
			"default": "./dist/slots/create.js"
		}
	},
	"typesVersions": {
		">=3.1": {
			"*": [
				"./dist/*.d.ts",
				"./dist/index.d.ts"
			],
			"group": [
				"./dist/group/*.d.ts",
				"./dist/group/index.d.ts"
			],
			"slots": [
				"./dist/slots/*.d.ts",
				"./dist/slots/index.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"homepage": "https://klass.pages.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flamrdevs/klass.git",
		"directory": "packages/core"
	},
	"scripts": {
		"build": "vite build"
	},
	"dependencies": {
		"clsx": "^2"
	},
	"publishConfig": {
		"access": "public"
	}
}
