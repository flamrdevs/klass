{
	"name": "@klass/qwik",
	"version": "4.0.0-next.29",
	"description": "Class variant utility for Qwik",
	"keywords": ["class", "classname", "variant", "variants", "utility", "responsive", "typescript", "qwik", "component", "styled", "polymorphic"],
	"license": "MIT",
	"author": {
		"name": "flamrdevs"
	},
	"type": "module",
	"main": "./dist/index.qwik.mjs",
	"qwik": "./dist/index.qwik.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.qwik.mjs"
		},
		"./create": {
			"types": "./dist/create.d.ts",
			"default": "./dist/create.qwik.mjs"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.qwik.mjs"
		},
		"./mono": {
			"types": "./dist/mono/index.d.ts",
			"default": "./dist/mono/index.qwik.mjs"
		},
		"./mono/create": {
			"types": "./dist/mono/create.d.ts",
			"default": "./dist/mono/create.qwik.mjs"
		}
	},
	"typesVersions": {
		">=3.1": {
			"*": ["./dist/*.d.ts", "./dist/index.d.ts"],
			"mono": ["./dist/mono/*.d.ts", "./dist/mono/index.d.ts"]
		}
	},
	"files": ["dist"],
	"homepage": "https://klass.pages.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flamrdevs/klass.git",
		"directory": "packages/qwik"
	},
	"scripts": {
		"build": "vite build"
	},
	"peerDependencies": {
		"@builder.io/qwik": "^1",
		"@klass/core": "workspace:*"
	},
	"devDependencies": {
		"@builder.io/qwik": "^1",
		"@klass/core": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
